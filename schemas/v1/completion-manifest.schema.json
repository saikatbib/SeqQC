{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seqqc.org/v1/completion-manifest.schema.json",
  "title": "SeqQC completed run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "workflow", "workflow_graph_digest",
    "input_manifest_digest", "outputs", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "workflow": { "$ref": "common.schema.json#/$defs/versioned_id" },
    "workflow_graph_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "input_manifest_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "reference_manifest_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "digest", "size_bytes"],
        "properties": {
          "artifact_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "digest": { "$ref": "common.schema.json#/$defs/digest" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "tool_manifest_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "completed_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
