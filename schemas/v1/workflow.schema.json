{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seqqc.org/v1/workflow.schema.json",
  "title": "SeqQC resolved workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow", "run_id", "tasks", "graph_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "workflow": { "$ref": "common.schema.json#/$defs/versioned_id" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "assay": { "enum": ["wgs", "wes", "bulk_rnaseq"] },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id", "module", "capability", "dependencies", "inputs",
          "outputs", "resources", "platforms"
        ],
        "properties": {
          "task_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "module": { "$ref": "common.schema.json#/$defs/versioned_id" },
          "capability": { "enum": ["qc", "alignment", "indexing", "aggregation", "reporting"] },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/uuid" }
          },
          "inputs": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/uuid" }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parameters": { "type": "object" },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cpu", "memory_bytes", "scratch_bytes"],
            "properties": {
              "cpu": { "type": "integer", "minimum": 1 },
              "memory_bytes": { "type": "integer", "minimum": 0 },
              "scratch_bytes": { "type": "integer", "minimum": 0 },
              "wall_time_seconds": { "type": "integer", "minimum": 1 }
            }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["windows", "macos", "linux"] }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "capability": { "const": "alignment" } }, "required": ["capability"] },
            "then": { "properties": { "platforms": { "items": { "const": "linux" } } } }
          }
        ]
      }
    },
    "graph_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
