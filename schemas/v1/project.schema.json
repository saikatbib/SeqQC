{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seqqc.org/v1/project.schema.json",
  "title": "SeqQC project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "display_name", "context",
    "owner_local_principal_id", "single_writer_policy", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "context": {
      "enum": ["human_clinical", "human_research", "preclinical", "other", "unspecified"]
    },
    "presentation_profile": { "enum": ["guided", "standard", "expert"] },
    "owner_local_principal_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "single_writer_policy": { "const": true },
    "retention_policy_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "active_threshold_preset": { "$ref": "common.schema.json#/$defs/versioned_id" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "archived_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/timestamp" },
        { "type": "null" }
      ]
    }
  }
}
