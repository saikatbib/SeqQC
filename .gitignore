# Build and dependency output
node_modules/
target/
dist/
coverage/
.toolchains/
*.log

# Mobile/store icon variants generated by Tauri are not part of the desktop
# release matrix. Keep only the desktop icons declared in tauri.conf.json.
apps/desktop/src-tauri/icons/android/
apps/desktop/src-tauri/icons/ios/
apps/desktop/src-tauri/icons/Square*.png
apps/desktop/src-tauri/icons/StoreLogo.png

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/

# SeqQC projects, archives, secrets, and generated evidence
*.seqc/
*.seqqc/
*.seqc-project
*.seqc-archive
*.key
*.pem
.env
.env.*

# Sequencing data must never be committed accidentally. Synthetic fixtures
# require an explicit allowlist and documented provenance.
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.sam

# Reviewed, deterministic, non-human Milestone 0 fixtures are the only
# sequencing files allowed in source control.
!test-data/synthetic/tiny-formats/tiny.fastq
!test-data/synthetic/tiny-formats/tiny.fastq.gz
!test-data/synthetic/tiny-formats/tiny.bam
!test-data/synthetic/tiny-formats/tiny.cram
